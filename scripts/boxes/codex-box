#!/usr/bin/env bash
# ==============================================================================
# codex-box: Lightweight Container Runner for Multi-Account OpenAI Codex
# ==============================================================================
set -euo pipefail

CONTAINERS_DIR="$HOME/.codex-containers"
CMD="$(basename "$0")"

# Handle Subcommands: add / new / create
if [ "${1:-}" = "add" ] || [ "${1:-}" = "new" ] || [ "${1:-}" = "create" ]; then
  if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
    echo "Usage: $CMD add <box-name>" >&2
    exit 1
  fi
  BOX_NAME="$2"
  if [[ "$BOX_NAME" =~ ^- ]]; then
    echo "Error: Invalid box name '$BOX_NAME'" >&2
    exit 1
  fi
  PROFILE_DIR="$CONTAINERS_DIR/$BOX_NAME"
  if [ -d "$PROFILE_DIR" ]; then
    echo "Box '$BOX_NAME' already exists ($PROFILE_DIR)."
    exit 0
  fi

  mkdir -p "$PROFILE_DIR/.codex" \
           "$HOME/.local/state/openusage"

  # Sync global skills and rules if available on host
  for src in skills rules; do
    if [ -d "$HOME/.codex/$src" ]; then
      mkdir -p "$PROFILE_DIR/.codex/$src"
      cp -rn "$HOME/.codex/$src"/. "$PROFILE_DIR/.codex/$src/" 2>/dev/null || true
    fi
  done
  if [ -f "$HOME/.codex/AGENTS.md" ]; then
    cp -n "$HOME/.codex/AGENTS.md" "$PROFILE_DIR/.codex/AGENTS.md" 2>/dev/null || true
  fi

  echo "✨ Created Codex box '$BOX_NAME' in $PROFILE_DIR"
  echo "Launch with: $CMD $BOX_NAME"
  exit 0
fi

# Handle Subcommands: list / ls
if [ "${1:-}" = "list" ] || [ "${1:-}" = "ls" ] || [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ]; then
  mkdir -p "$CONTAINERS_DIR"
  echo "📦 Codex Boxes in ~/.codex-containers:"
  echo ""

  boxes=("$CONTAINERS_DIR"/*)
  if [ ! -e "${boxes[0]}" ]; then
    echo "  (No boxes created yet. Create one with: $CMD add <name>)"
    exit 0
  fi

  printf "  %-20s %-18s %s\n" "BOX NAME" "STATUS" "STORAGE LOCATION"
  printf "  %-20s %-18s %s\n" "────────" "──────" "────────────────"

  for dir in "$CONTAINERS_DIR"/*; do
    if [ -d "$dir" ]; then
      name=$(basename "$dir")
      status="Ready"
      if [ -f "$dir/.codex/auth.json" ] || [ -f "$dir/auth.json" ]; then
        status="Authenticated"
      elif [ -f "$dir/.codex/config.toml" ] || [ -f "$dir/config.toml" ]; then
        status="Configured"
      elif [ -d "$dir/.codex" ]; then
        status="Initialized"
      fi
      printf "  %-20s %-18s %s\n" "$name" "$status" "$dir"
    fi
  done
  echo ""
  echo "Usage:"
  echo "  $CMD add <box-name>     Create a new box"
  echo "  $CMD <box-name> [args]  Launch an existing box"
  exit 0
fi

# Handle Subcommands: rm / delete / remove
if [ "${1:-}" = "rm" ] || [ "${1:-}" = "delete" ] || [ "${1:-}" = "remove" ]; then
  # Require a non-empty name: `rm ""` would resolve to $CONTAINERS_DIR/ and
  # `rm -rf` would delete every box profile under the containers root.
  if [ $# -lt 2 ] || [ -z "${2:-}" ] || [ "$2" = "." ] || [ "$2" = ".." ]; then
    echo "Usage: $CMD rm <box-name>" >&2
    exit 1
  fi
  TARGET="$CONTAINERS_DIR/$2"
  if [ -d "$TARGET" ]; then
    rm -rf "$TARGET"
    echo "🗑️  Removed box '$2' ($TARGET)"
  else
    echo "Box '$2' does not exist." >&2
  fi
  exit 0
fi

# Handle Subcommand: login
if [ "${1:-}" = "login" ]; then
  if [ $# -lt 2 ]; then
    echo "Usage: $CMD login <box-name>" >&2
    exit 1
  fi
  BOX_TARGET="$2"
  shift 2 || true
  exec "$0" "$BOX_TARGET" login "$@"
fi

# Handle Help
if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "help" ]; then
  cat << HELP
Usage:
  $CMD add <box-name>         Create a new box profile
  $CMD <box-name> [options]   Launch an existing box
  $CMD list                   List all active boxes
  $CMD rm <box-name>          Delete a box profile

Examples:
  $CMD add dev
  $CMD dev
  $CMD dev status
  $CMD list

HELP
  exit 0
fi

ACCOUNT="$1"
shift || true

PROFILE_DIR="$CONTAINERS_DIR/$ACCOUNT"
if [ ! -d "$PROFILE_DIR" ]; then
  echo "Error: Box '$ACCOUNT' does not exist." >&2
  echo "To create this box, run: $CMD add $ACCOUNT" >&2
  exit 1
fi

mkdir -p "$PROFILE_DIR/.codex" "$HOME/.local/state/openusage"

# Re-sync global skills and rules into the box on every launch
for src in skills rules; do
  if [ -d "$HOME/.codex/$src" ]; then
    mkdir -p "$PROFILE_DIR/.codex/$src"
    cp -ru "$HOME/.codex/$src"/. "$PROFILE_DIR/.codex/$src/" 2>/dev/null || true
  fi
done
if [ -f "$HOME/.codex/AGENTS.md" ]; then
  cp -u "$HOME/.codex/AGENTS.md" "$PROFILE_DIR/.codex/AGENTS.md" 2>/dev/null || true
fi

# Prefer an explicit BWRAP_BIN (tests), then distro bwrap: on Ubuntu 24.04+
# Homebrew bwrap lacks the AppArmor profile and fails with
# "setting up uid map: Permission denied".
if [ -n "${BWRAP_BIN:-}" ] && [ -x "$BWRAP_BIN" ]; then
  :
elif [ -x /usr/bin/bwrap ]; then
  BWRAP_BIN=/usr/bin/bwrap
elif BWRAP_BIN=$(command -v bwrap 2>/dev/null) && [ -n "$BWRAP_BIN" ]; then
  :
elif [ -x /home/linuxbrew/.linuxbrew/bin/bwrap ]; then
  BWRAP_BIN=/home/linuxbrew/.linuxbrew/bin/bwrap
else
  echo "Error: bubblewrap (bwrap) not found." >&2
  exit 1
fi
if [ ! -x "$BWRAP_BIN" ]; then
  echo "Error: bubblewrap (bwrap) not found." >&2
  exit 1
fi

CODEX_BIN=$(which codex 2>/dev/null || echo "$HOME/.local/bin/codex")
if [ ! -x "$CODEX_BIN" ]; then
  echo "Error: Codex CLI not found in PATH or ~/.local/bin/codex." >&2
  exit 1
fi

RUNTIME_BIND=()
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
  RUNTIME_BIND=(--bind "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR")
elif [ -d "/run/user/$(id -u)" ]; then
  RUNTIME_BIND=(--bind "/run/user/$(id -u)" "/run/user/$(id -u)")
fi

CODEX_EXTRA_BINDS=()
if [ -d "$HOME/.codex/packages" ]; then
  mkdir -p "$PROFILE_DIR/.codex/packages"
  CODEX_EXTRA_BINDS+=(--ro-bind "$HOME/.codex/packages" "$HOME/.codex/packages")
fi
if [ -d "$HOME/.codex/plugins" ]; then
  mkdir -p "$PROFILE_DIR/.codex/plugins"
  CODEX_EXTRA_BINDS+=(--ro-bind "$HOME/.codex/plugins" "$HOME/.codex/plugins")
fi

# If the Codex binary lives under ~/.codex, re-bind it so the sandboxed process
# can still execute it after the profile mount hides the host tree. Never
# remount ~/.codex itself — that would replace the per-box profile bind with
# the host tree and expose host auth.json inside the box.
CODEX_REAL=$(realpath "$CODEX_BIN" 2>/dev/null || true)
if [[ -n "$CODEX_REAL" && "$CODEX_REAL" == "$HOME/.codex/"* ]]; then
  REAL_DIR=$(dirname "$CODEX_REAL")
  if [[ "$REAL_DIR" == "$HOME/.codex" ]]; then
    # Binary sits in ~/.codex root — bind only the file, not the directory.
    CODEX_EXTRA_BINDS+=(--ro-bind "$CODEX_REAL" "$CODEX_REAL")
  elif [[ "$REAL_DIR" == "$HOME/.codex/"* && "$REAL_DIR" != "$HOME/.codex/packages"* && "$REAL_DIR" != "$HOME/.codex/plugins"* ]]; then
    REL_PATH="${REAL_DIR#$HOME/.codex/}"
    mkdir -p "$PROFILE_DIR/.codex/$REL_PATH"
    CODEX_EXTRA_BINDS+=(--ro-bind "$REAL_DIR" "$REAL_DIR")
  fi
fi

exec "$BWRAP_BIN" \
  --ro-bind / / \
  --dev /dev \
  --proc /proc \
  --bind /tmp /tmp \
  --bind "$HOME" "$HOME" \
  "${RUNTIME_BIND[@]}" \
  --bind "$PROFILE_DIR/.codex" "$HOME/.codex" \
  "${CODEX_EXTRA_BINDS[@]}" \
  --bind "$HOME/.local/state/openusage" "$HOME/.local/state/openusage" \
  --setenv HOME "$HOME" \
  --setenv CODEX_ACCOUNT "$ACCOUNT" \
  --chdir "$PWD" \
  "$CODEX_BIN" "$@"
