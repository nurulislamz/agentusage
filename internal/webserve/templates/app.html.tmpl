{{define "app"}}<div id="app" class="shell layout-{{.Layout.ID}}{{if eq .MobileView "detail"}} mobile-view-detail{{else}} mobile-view-roster{{end}}" data-layout="{{.Layout.ID}}"{{if and (not .HasData) (not .Filtered)}} hidden{{end}} hx-get="partial/app?layout={{.Layout.ID}}" hx-include="#filter-input" hx-trigger="every {{.RefreshSeconds}}s" hx-target="#app" hx-swap="outerHTML" hx-indicator="#fetching-detail">
  <header class="header top-nav">
    <div id="header" class="header-main">
      <div class="brand-group">
        <span class="logo" aria-hidden="true">{{template "apple-logo"}}</span>
        <span class="brand"><span class="brand-title"><span class="brand-agent">agent</span><span class="brand-usage">Usage</span></span> <span class="brand-studio">{{if .Env.ThemeTokens.Name}}{{.Env.ThemeTokens.Name}}{{else}}Ceramic Studio{{end}}</span></span>
      </div>
      <span id="fetching-header" class="fetching"><span class="spin" aria-hidden="true">⠋</span> <span class="fetching-text">Fetching...</span></span>
      <span class="spacer"></span>
      <nav class="layout-nav" aria-label="Layout view">{{range .Layouts}}<button type="button" class="layout-btn{{if eq .ID $.Layout.ID}} active{{end}}" data-layout="{{.ID}}" hx-post="actions/layout" hx-vals='{"layout":"{{.ID}}"}' aria-pressed="{{if eq .ID $.Layout.ID}}true{{else}}false{{end}}"><span class="layout-icon" aria-hidden="true">{{.Icon}}</span><span class="layout-label">{{.Label}}</span></button>{{end}}</nav>
      <span class="spacer"></span>
      <div class="right-controls">
        <div class="search-box{{if .Filtered}} has-query{{end}}" id="search-box" role="button" tabindex="0" aria-label="Filter providers (/)">
          <span class="search-kbd">/</span>
          <span class="search-text">{{if .Filtered}}{{.Filter}}{{else}}filter providers…{{end}}</span>
          {{if .Filtered}}
          <button type="button" class="btn-search-clear" id="btn-search-clear" title="Clear filter" aria-label="Clear filter">✕</button>
          {{end}}
        </div>
        <span class="header-count">{{len .Views}} agents{{if .Stats.AtLimit}} · <span class="count-warn">{{.Stats.AtLimit}} at limit</span>{{end}}</span>
      </div>
    </div>
  </header>
  <div class="hairline" aria-hidden="true"></div>
  <div class="body">
    <nav id="nav" class="nav" hx-target="#app" hx-swap="outerHTML" aria-label="Account roster" hx-indicator="#fetching-detail"{{if ne .Layout.ID "split"}} hidden aria-hidden="true"{{end}}>{{if eq .Layout.ID "split"}}{{template "nav" .}}{{end}}</nav>
    <div class="vsep" aria-hidden="true"{{if ne .Layout.ID "split"}} hidden{{end}}></div>
    <main class="panel" aria-label="{{.Layout.Hint}}">
      <div id="panel"><span id="fetching-detail" class="fetching"><span class="spin" aria-hidden="true">⠋</span> <span class="fetching-text">Fetching...</span></span>{{if .HasData}}<div class="stats-banner">
        <div class="stat-box">
          <div class="stat-lab">Fleet Health</div>
          <div class="stat-val">{{.Stats.Health}} <span class="health-tag tag-{{.Stats.HealthTone}}">{{.Stats.HealthTag}}</span></div>
          <div class="stat-note">{{.Stats.HealthNote}}</div>
        </div>
        <div class="stat-box">
          <div class="stat-lab">Accounts At Limit</div>
          <div class="stat-val">{{.Stats.AtLimit}} <span class="health-tag tag-{{.Stats.AtLimitTone}}">{{.Stats.AtLimitTag}}</span></div>
          <div class="stat-note">{{.Stats.AtLimitNote}}</div>
        </div>
        <div class="stat-box">
          <div class="stat-lab">Tightest Window</div>
          <div class="stat-val mono">{{.Stats.Tightest}}</div>
          <div class="stat-note">{{.Stats.TightestNote}}</div>
        </div>
        <div class="stat-box">
          <div class="stat-lab">{{.Stats.HeadroomLabel}}</div>
          <div class="stat-val mono">{{.Stats.Headroom}}</div>
          <div class="stat-note">{{.Stats.HeadroomNote}}</div>
        </div>
      </div>{{end}}{{if not .HasData}}{{if .Filtered}}<div class="empty-filter-state">
        <div class="empty-filter-icon" aria-hidden="true">⊘</div>
        <div class="empty-filter-msg"><strong>No matches.</strong> No providers matching "{{.Filter}}"</div>
        <button type="button" class="btn-clear-filter" id="btn-clear-filter" title="Clear filter query">Clear filter</button>
      </div>{{else}}<p class="dim">No providers.</p>{{end}}{{end}}{{if eq .Layout.ID "split"}}{{with .Selected}}{{template "mobilebar" (cctx $ .)}}{{template "cockpit" (cctx $ .)}}{{end}}{{else if eq .Layout.ID "matrix"}}{{template "matrix" .}}{{else if eq .Layout.ID "bento"}}{{template "bento" .}}{{else}}{{template "board" .}}{{end}}</div>
    </main>
  </div>
  <div class="hairline" aria-hidden="true"></div>
  <footer class="footer"><div id="footer" class="footer-main" hx-indicator="#fetching-footer">{{template "footer" .}}</div></footer>
  <span hidden aria-hidden="true">
    <button id="key-next" hx-get="partial/app?dir=next&amp;layout={{.Layout.ID}}" tabindex="-1"></button>
    <button id="key-prev" hx-get="partial/app?dir=prev&amp;layout={{.Layout.ID}}" tabindex="-1"></button>
    <button id="key-refresh" hx-get="partial/app?refresh=1&amp;layout={{.Layout.ID}}{{with .Selected}}&amp;focus={{urlquery .AccountID}}{{end}}" tabindex="-1"></button>
    <button id="key-refresh-all" hx-get="partial/app?refresh=1&amp;layout={{.Layout.ID}}" tabindex="-1"></button>
    <button id="key-mode" hx-post="actions/usage-mode" tabindex="-1"></button>
    <button id="key-theme-fwd" hx-post="actions/theme" tabindex="-1"></button>
    <button id="key-theme-back" hx-post="actions/theme" hx-vals='{"direction":"backward"}' tabindex="-1"></button>
    <button id="key-layout-cycle" hx-post="actions/layout" hx-vals='{"layout":"next"}' tabindex="-1"></button>
    <button id="key-layout-main" hx-post="actions/layout" hx-vals='{"layout":"nextmain"}' tabindex="-1"></button>
    <button id="key-view-roster" hx-post="actions/view" hx-vals='{"view":"roster"}' tabindex="-1"></button>
  </span>
</div>
{{template "oob" .}}
{{end}}

{{define "oob"}}<style id="theme-vars" hx-swap-oob="outerHTML">{{themeVars .Env.ThemeTokens}}</style>
<meta id="meta-theme-color" hx-swap-oob="outerHTML" content="{{if .Env.ThemeTokens.Base}}{{.Env.ThemeTokens.Base}}{{else}}#f5f5f7{{end}}">
<div id="splash" class="splash" hx-swap-oob="outerHTML" hidden></div>
<div id="empty-state" class="empty" hx-swap-oob="outerHTML"{{if or .HasData .Filtered}} hidden{{end}}><div class="splash-emblem dim" aria-hidden="true">{{template "apple-logo-lg"}}</div><h2 id="empty-title">{{.EmptyTitle}}</h2><p id="empty-error" class="empty-error"{{if not .EmptyError}} hidden{{end}}>{{.EmptyError}}</p><p id="empty-hint">{{.EmptyHint}}</p></div>
<div id="status-bar" class="status-bar{{if .StatusToast}} toast{{end}}" hx-swap-oob="outerHTML"{{if not .StatusText}} hidden{{end}}>{{.StatusText}}</div>{{end}}
