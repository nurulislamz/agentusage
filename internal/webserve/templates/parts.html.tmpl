{{define "providers"}}<div class="providers-groups">{{range .Groups}}
<section class="providers-group">
  <div class="providers-group-title">{{.ProviderName}} <span class="providers-count">{{len .Rows}}</span></div>
  {{range .Rows}}
  <div class="providers-row{{if not .Enabled}} providers-row-hidden{{end}}">
    <span class="providers-name">{{.AccountID}}</span>
    {{if .Enabled}}<span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span>{{else}}<span class="pill dim">HIDDEN</span>{{end}}
    <button type="button" class="providers-btn" hx-post="actions/providers" hx-vals='{"op":"{{if .Enabled}}hide{{else}}show{{end}}","account_id":"{{.AccountID}}"}' hx-target="#app" hx-swap="outerHTML" title="{{if .Enabled}}Hide from dashboard{{else}}Show on dashboard{{end}}" aria-label="{{if .Enabled}}Hide {{.AccountID}}{{else}}Show {{.AccountID}}{{end}}">{{if .Enabled}}Hide{{else}}Show{{end}}</button>
    <button type="button" class="providers-btn danger" hx-post="actions/providers" hx-vals='{"op":"delete","account_id":"{{.AccountID}}"}' hx-target="#app" hx-swap="outerHTML" hx-confirm="Remove {{.AccountID}} from agentUsage?" title="Remove account and stored credentials" aria-label="Remove {{.AccountID}}">✕</button>
  </div>
  {{end}}
</section>
{{end}}{{if not .Groups}}<p class="dim" style="margin:0">No accounts configured.</p>{{end}}</div>{{end}}

{{define "providers-oob"}}<div id="providers-content" hx-swap-oob="innerHTML">{{template "providers" .}}</div>{{end}}

{{define "nav"}}{{if .HasData}}{{range .Groups}}
<div class="group{{if .Active}} active{{end}}" style="--p:{{.Accent}}">{{upper .ProviderID}} ({{len .Items}}){{if .Active}} ★{{end}}</div>
{{range .Items}}<button type="button" class="item nav-item{{if .Active}} selected{{end}}" hx-get="partial/app?account={{urlquery .Key}}" style="--p:{{accent .AccentColor}}">
  <span class="rail"></span>
  <span class="name">{{if .StatusIcon}}{{.StatusIcon}}{{else}}●{{end}} {{.AccountID}}</span>
  <span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span>
  <div class="sum">
    {{if .HasGauge}}
      {{$cls := pillClass .StatusBadge}}
      <span class="mini"><i style="width:{{pct0 .GaugePercent}}%;background:{{if eq $cls "crit"}}var(--danger){{else if eq $cls "warn"}}var(--yellow){{else if eq $cls "peach"}}var(--peach){{else if eq $cls "auth"}}var(--warn){{else}}{{gaugeColor .FirstTone}}{{end}}"></i></span>
    {{else if .Meters}}
      {{range $i, $m := .Meters}}{{if eq $i 0}}{{if $m.Pct}}<span class="mini"><i style="width:{{pct0 $m.Pct}}%;background:{{gaugeColor $m.Tone}}"></i></span>{{end}}{{end}}{{end}}
    {{end}}
    <span class="sum-text">{{if .SummaryDisplay}}{{.SummaryDisplay}}{{else}}{{.Summary}}{{end}}</span>
    <span class="dim">{{if .NextDisplay}}{{.NextDisplay}}{{end}}</span>
  </div>
  <div class="meters sr-only">
    {{if .Meters}}{{range .Meters}}{{if .Pct}}<span class="meter {{toneClass .Tone}}"><span class="meter-lab">{{if .Short}}{{.Short}}{{else}}{{.Label}}{{end}}</span> <span class="mini"><i style="width:{{pct0 .Pct}}%;background:{{gaugeColor .Tone}}"></i></span> <span class="meter-val">{{pct0 .Pct}}%</span></span>{{else}}<span class="meter text"><span class="meter-lab">{{if .Short}}{{.Short}}{{else}}{{.Label}}{{end}}</span>: <span class="meter-val">{{.Value}}</span></span>{{end}}{{end}}{{else}}<span class="dim">{{.Summary}}</span>{{end}}
  </div>
  <span class="mobile-chevron" aria-hidden="true">›</span>
</button>{{end}}
{{end}}{{end}}{{end}}

{{define "mobilebar"}}<div class="mobile-back-bar">
  <button type="button" class="mobile-back-btn" id="mobile-back-btn" hx-post="actions/view" hx-vals='{"view":"roster"}' aria-label="Back to account roster"><span aria-hidden="true">‹</span> Back</button>
  <div class="mobile-pager" role="navigation" aria-label="Account navigation">
    <button type="button" class="mobile-pager-btn" id="mobile-prev-btn" hx-get="partial/app?dir=wrapprev" aria-label="Previous account">‹</button>
    <span class="mobile-pager-count">{{.V.Position}} / {{.V.Total}}</span>
    <button type="button" class="mobile-pager-btn" id="mobile-next-btn" hx-get="partial/app?dir=wrapnext" aria-label="Next account">›</button>
  </div>
  <span class="mobile-back-acc">{{.V.AccountID}}</span>
</div>{{end}}

{{define "cockpit"}}{{with .V}}
<div class="hero">
  <h1><span class="dot"></span> {{if .HeroAccountID}}{{.HeroAccountID}}{{else}}{{.AccountID}}{{end}}<span class="fetching"><span class="spin" aria-hidden="true">⠋</span></span></h1>
  <div class="hero-right">
    <span>{{if .HeroMeta}}{{.HeroMeta}}{{else}}{{if .ProviderName}}{{.ProviderName}}{{else}}{{.ProviderID}}{{end}}{{if .Detail}} · {{.Detail}}{{end}}{{end}}</span>
    <span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span>
    <button type="button" class="footer-btn btn-cockpit-refresh" hx-get="partial/app?refresh=1&amp;focus={{urlquery .AccountID}}" hx-target="#app" hx-swap="outerHTML" title="Refresh account" aria-label="Refresh {{.AccountID}}">{{template "icon-refresh"}}</button>
  </div>
</div>
{{template "cockpit-body" $}}
{{end}}{{end}}

{{define "cockpit-modal"}}{{with .V}}
<div class="hero">
  <h1><span class="dot"></span> {{if .HeroAccountID}}{{.HeroAccountID}}{{else}}{{.AccountID}}{{end}}<span class="fetching"><span class="spin" aria-hidden="true">⠋</span></span></h1>
  <div class="hero-right">
    <span>{{if .HeroMeta}}{{.HeroMeta}}{{else}}{{if .ProviderName}}{{.ProviderName}}{{else}}{{.ProviderID}}{{end}}{{if .Detail}} · {{.Detail}}{{end}}{{end}}</span>
    <span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span>
    <button type="button" class="footer-btn btn-cockpit-refresh" id="inspect-refresh" hx-get="inspect?account={{urlquery .AccountID}}&amp;refresh=1" hx-target="#inspect-content" hx-swap="innerHTML" title="Refresh account" aria-label="Refresh {{.AccountID}}">{{template "icon-refresh"}}</button>
  </div>
</div>
{{template "cockpit-body" $}}
{{end}}{{end}}

{{define "cockpit-body"}}{{with .V}}
<div class="subhero">
  {{if or .HeroPrimaryStat .SummaryDisplay}}<div><strong>{{if .HeroPrimaryStat}}{{.HeroPrimaryStat}}{{else}}{{.SummaryDisplay}}{{end}}</strong>{{$cycle := cleanHeroCycle .HeroCycleStat .CycleSchedule}}{{if $cycle}} <span class="reset">· {{$cycle}}</span>{{end}}</div>{{else}}{{$cycle := cleanHeroCycle .HeroCycleStat .CycleSchedule}}{{if $cycle}}<div><span class="reset">{{$cycle}}</span></div>{{end}}{{end}}
  {{if .RefreshedText}}<div class="last-refreshed">{{.RefreshedText}}</div>{{end}}
</div>
<div class="accent-line"></div>

<div class="panel-cards-grid">
  <section class="card"><div class="card-header"><h2>Usage &amp; quotas</h2></div>{{if .Graphs}}<div class="lin-list">{{range .Graphs}}{{if .Title}}<div class="gauge-group"><div class="gauge-group-title">{{.Title}}</div><div class="gauge-group-body">{{range .Items}}{{template "lin-gauge" .}}{{end}}</div></div>{{else}}{{range .Items}}{{template "lin-gauge" .}}{{end}}{{end}}{{end}}</div>{{else if not .Tables}}<p class="dim" style="margin:0">{{if .SummaryDisplay}}{{.SummaryDisplay}}{{else if .Summary}}{{.Summary}}{{else}}No quota windows reported for this account.{{end}}</p>{{end}}{{template "metric-table" .Tables}}</section>
  {{if .Timers}}<section class="card"><div class="card-header"><h2>Timers &amp; schedule</h2></div>{{range .Timers}}{{if withIn .Duration}}<div class="timer {{if .Urgent}}tone-warn{{else}}tone-ok{{end}}"><span class="dot"></span><span>{{.Label}}</span><span class="when">{{withIn .Duration}}</span></div>{{end}}{{end}}</section>{{else if and .HasTimerFallback (withIn .NextReset)}}<section class="card"><div class="card-header"><h2>Timers &amp; schedule</h2></div><div class="timer tone-ok"><span class="dot"></span><span>Next Reset</span><span class="when">{{withIn .NextReset}}</span></div></section>{{end}}
  {{if .DailyCost}}{{with cockpitSpark .DailyCost}}<section class="card"><div class="card-header"><h2>Activity &amp; trend</h2></div><div style="padding:4px 0 8px">{{.}}</div>{{template "metric-table" $.V.TrendStats}}</section>{{end}}{{end}}
  {{template "cards" $}}
</div>
{{end}}{{end}}
{{define "cards"}}{{range .V.Cards}}{{if and .Title .Rows}}<section class="card{{if gt (len .Rows) 6}} span-2{{end}}" style="--card:{{cardColor .Color}}"><div class="card-header"><h2>{{.Title}}</h2></div>{{template "card-rows" (cardctx $.M .)}}</section>{{end}}{{end}}{{end}}

{{define "card-rows"}}{{range .Card.Rows}}{{if eq .Kind "heading"}}<div class="heading">{{if .Value}}{{.Value}}{{else}}{{.Label}}{{end}}</div>
{{else if eq .Kind "gauge"}}<div class="gauge-block {{toneClass .Tone}}"><div class="gauge-header"><span class="gauge-label">{{.Label}}</span><span class="gauge-stat"><b class="stat-val">{{rowPct .}}%</b><span class="pill {{pillClass .Tone}}">{{$.M.UsageMode}}</span></span></div><div class="gauge" style="color:{{gaugeColor .Tone}}"><i style="width:{{rowPct .}}%;background:currentColor"></i><span class="gauge-threshold" style="left:{{if eq $.M.UsageMode "used"}}80{{else}}20{{end}}%" aria-hidden="true"></span></div><div class="caption">{{rowCaption . $.M.UsageMode}}</div></div>
{{else if eq .Kind "timer"}}{{if .Value}}<div class="timer {{toneClass .Tone}}"><span class="dot"></span><span>{{.Label}}</span><span class="when">{{.Value}}</span>{{if .Hint}}<span class="hint">{{.Hint}}</span>{{end}}</div>{{end}}
{{else if eq .Kind "kv"}}{{if .Value}}<div class="kv"><span class="dim">{{.Label}}</span><span class="kv-val">{{.Value}}</span></div>{{end}}
{{else}}<div class="text-row">{{if .Value}}{{.Value}}{{else}}{{.Label}}{{end}}</div>{{end}}{{end}}{{end}}

{{define "matrix"}}<div class="matrix-container" role="grid" aria-label="Dense Roster Matrix HUD">
{{range $i, $g := .Groups}}
<section class="provider-group-box" style="--p:{{$g.Accent}}">
  <header class="provider-group-header">
    <div class="provider-group-title"><span class="provider-indicator" aria-hidden="true"></span><span class="provider-name">{{$g.ProviderName}}</span><span class="provider-count">{{len $g.Items}} {{if eq (len $g.Items) 1}}AGENT{{else}}AGENTS{{end}}</span></div>
    <div class="provider-group-meta"><span class="pill {{$g.Rollup}}">{{$g.RollupLabel}}</span></div>
  </header>
  <div class="matrix-table-wrap">
    <table class="matrix-table" role="table" aria-label="{{$g.ProviderName}} Matrix">
      <colgroup><col style="width: 25%"><col style="width: 12%"><col style="width: 17%"><col style="width: 17%"><col style="width: 17%"><col style="width: 12%">{{if $.HasTrendColumn}}<col style="width: 80px">{{end}}<col style="width: 32px"></colgroup>
      {{if eq $i 0}}<thead><tr><th scope="col">ACCOUNT</th><th scope="col">STATUS</th><th scope="col">QUOTA 1</th><th scope="col">QUOTA 2</th><th scope="col">QUOTA 3</th><th scope="col">NEXT RESET</th>{{if $.HasTrendColumn}}<th scope="col">TREND</th>{{end}}<th scope="col" aria-label="Toggle"></th></tr></thead>{{end}}
      <tbody>
      {{range $g.Items}}
        <tr class="matrix-row{{if .Active}} selected{{end}}{{if .Expanded}} expanded{{end}}" tabindex="0" hx-get="partial/app?account={{urlquery .Key}}&amp;expand={{urlquery .Key}}" data-acc="{{.AccountID}}" style="--p:{{accent .AccentColor}}">
          <td role="rowheader"><div class="matrix-app"><span class="matrix-app-icon">{{if .StatusIcon}}{{.StatusIcon}}{{else}}●{{end}}</span><div><div class="matrix-app-title">{{.AccountID}}</div></div></div></td>
          <td><span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span></td>
          {{range .MatrixCells}}<td>{{if .}}{{template "quota-cell" .}}{{else}}<span class="dim">—</span>{{end}}</td>{{end}}
          <td><span class="matrix-reset{{if .Urgent}} urgent{{end}}">{{if .NextDisplay}}{{.NextDisplay}}{{else}}—{{end}}</span></td>
          {{if $.HasTrendColumn}}<td><div class="matrix-trend">{{with matrixSpark .DailyCost}}{{.}}{{else}}<span class="dim">—</span>{{end}}</div></td>{{end}}
          <td><span class="matrix-toggle" title="Toggle details" aria-label="Toggle details for {{.AccountID}}" aria-expanded="{{if .Expanded}}true{{else}}false{{end}}">{{if .Expanded}}▾{{else}}▸{{end}}</span></td>
        </tr>
        {{if .Expanded}}<tr class="matrix-drawer-row"><td colspan="{{if $.HasTrendColumn}}8{{else}}7{{end}}"><div class="matrix-drawer">{{template "cockpit" (cctx $ .)}}</div></td></tr>{{end}}
      {{end}}
      </tbody>
    </table>
  </div>
</section>
{{end}}
</div>{{end}}

{{define "quota-cell"}}{{if .Pct}}<div class="matrix-metric-wrap {{toneClass .Tone}}{{if .Depleted}} depleted{{end}}"><span class="matrix-metric-lab">{{if .Short}}{{.Short}}{{else}}{{.Label}}{{end}}</span><span class="matrix-metric-bar"><i style="width:{{pct0 .Pct}}%;background:{{gaugeColor .Tone}}"></i></span><span class="matrix-metric-val">{{if .Caption}}{{.Caption}}{{else}}{{pct0 .Pct}}%{{end}}</span></div>{{else}}<span class="matrix-metric-wrap"><span class="matrix-metric-lab">{{if .Short}}{{.Short}}{{else}}{{.Label}}{{end}}</span><span class="matrix-metric-val">{{if .Value}}{{.Value}}{{else}}—{{end}}</span></span>{{end}}{{end}}

{{define "bento"}}<div class="bento-container" role="grid" aria-label="Viewport Bento Glance Tiles">
{{range $g := .Groups}}
<section class="provider-group-box bento-provider-group" style="--p:{{$g.Accent}}">
  <header class="provider-group-header">
    <div class="provider-group-title"><span class="provider-indicator" aria-hidden="true"></span><span class="provider-name">{{$g.ProviderName}}</span><span class="provider-count">{{len $g.Items}} {{if eq (len $g.Items) 1}}AGENT{{else}}AGENTS{{end}}</span></div>
    <div class="provider-group-meta"><span class="pill {{$g.Rollup}}">{{$g.RollupLabel}}</span></div>
  </header>
  <div class="bento-tiles-grid" data-count="{{len $g.Items}}">
  {{range $g.Items}}
    {{$compact := or (eq .BentoSpan "compact") (and (not .Graphs) (le (len .BentoRows) 1) (not .DailyCost))}}
    <div role="button" tabindex="0" class="bento-tile agent-card{{if $compact}} is-compact card-compact{{end}} bento-{{.BentoSpan}}{{if .IsAlert}} alert{{end}}{{if .Active}} selected{{end}}" hx-get="inspect?account={{urlquery .Key}}" hx-target="#inspect-content" hx-swap="innerHTML" style="--p:{{accent .AccentColor}}" title="Click to inspect {{.AccountID}}" aria-label="Inspect {{.AccountID}}">
      <div class="bento-tile-head">
        <div class="card-identity">
          <div class="card-avatar" style="background:{{.AvatarBg}};color:{{.AvatarColor}}">{{.AvatarText}}</div>
          <div class="bento-head-left">
            <span class="bento-acc-name">{{.AccountID}}</span>
            <span class="card-sub">{{subtitle .}}</span>
          </div>
        </div>
        <span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span>
      </div>
      <div class="bento-tile-body{{if $compact}} is-compact{{end}}">{{if .BentoRows}}{{range .BentoRows}}{{if .Pct}}<div class="quota-row bento-quota-row {{toneClass .Tone}}{{if .Depleted}} depleted{{end}}"><span class="q-title bento-quota-lab"><span class="q-pill">{{timebandLabel .Label}}</span> {{cleanQuotaLabel (timebandLabel .Label) .Label}}{{if .Depleted}} <span class="limit-flag">Limit reached</span>{{end}}</span><div class="bento-quota-bar"><div class="q-bar {{barTone .Tone}}" style="width:{{pct0 .Pct}}%;background:{{gaugeColor .Tone}}"></div></div><span class="q-vals bento-quota-pct">{{if .Depleted}}{{pct0 .Pct}}%{{else if .Caption}}{{.Caption}}{{else}}{{pct0 .Pct}}%{{end}}</span></div>{{else if .Value}}<div class="bento-quota-row"><span class="bento-quota-lab">{{.Label}}</span><span class="dim" style="grid-column:span 2">{{.Value}}</span></div>{{end}}{{end}}{{else}}<div class="dim" style="font-size:11px">{{if .Summary}}{{.Summary}}{{else}}No active quotas{{end}}</div>{{end}}</div>
      <div class="bento-tile-foot card-footer"><span class="bento-reset-hint{{if .Urgent}} urgent{{end}}">{{if .NextDisplay}}{{.NextDisplay}}{{end}}</span><span class="card-inspect">Inspect →</span>{{with bentoSpark .DailyCost}}<div class="bento-spark-wrap">{{.}}</div>{{end}}</div>
    </div>
  {{end}}
  </div>
</section>
{{end}}
</div>{{end}}

{{define "board"}}<div class="board-container" role="list" aria-label="{{.Layout.Hint}}">
{{range $g := .Groups}}
<section class="provider-group-box board-provider-group" style="--p:{{$g.Accent}}">
  <header class="provider-group-header">
    <div class="provider-group-title"><span class="provider-indicator" aria-hidden="true"></span><span class="provider-name">{{$g.ProviderName}}</span><span class="provider-count">{{len $g.Items}} {{if eq (len $g.Items) 1}}AGENT{{else}}AGENTS{{end}}</span></div>
    <div class="provider-group-meta"><span class="pill {{$g.Rollup}}">{{$g.RollupLabel}}</span></div>
  </header>
  <div class="board-grid board-{{$.Layout.ID}}" data-count="{{len $g.Items}}">
  {{range $g.Items}}{{if eq $.Layout.ID "dials"}}{{template "dial-card" .}}{{else if eq $.Layout.ID "strips"}}{{template "strip-card" .}}{{else}}{{template "bar-card" .}}{{end}}{{end}}
  </div>
</section>
{{end}}
</div>{{end}}

{{define "agent-head"}}<div class="agent-head card-header"><div class="card-identity"><div class="card-avatar" style="background:{{.AvatarBg}};color:{{.AvatarColor}}">{{.AvatarText}}</div> <div><div class="agent-name card-name">{{if .StatusIcon}}{{.StatusIcon}}{{else}}●{{end}} {{.AccountID}}</div> <div class="agent-plan card-sub">{{subtitle .}}</div></div></div> <span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span></div>{{end}}

{{define "bar-card"}}{{$sparse := and (not .Graphs) (le (len .Tables) 1) (not .TrendStats) (not .DailyCost)}}<button type="button" class="agent agent-card{{if $sparse}} is-compact card-compact{{end}}{{if .IsAlert}} alert{{end}}{{if .Active}} selected{{end}}" hx-get="inspect?account={{urlquery .Key}}" hx-target="#inspect-content" hx-swap="innerHTML" style="--p:{{accent .AccentColor}};--tone:{{gaugeColor .FirstTone}}" aria-label="Inspect {{.AccountID}}">{{template "agent-head" .}}{{if or .Graphs .Tables .TrendStats}}<div class="quotas-group{{if $sparse}} is-compact{{end}}">{{if .Graphs}}<div class="lin-list">{{range .Graphs}}{{if .Title}}<div class="gauge-group"><div class="gauge-group-title">{{.Title}}</div><div class="gauge-group-body">{{range .Items}}{{template "lin-gauge" .}}{{end}}</div></div>{{else}}{{range .Items}}{{template "lin-gauge" .}}{{end}}{{end}}{{end}}</div>{{end}}{{template "metric-table" .Tables}}{{$spark := cardSpark .DailyCost}}{{if or .TrendStats $spark}}<div class="agent-foot">{{template "metric-table" .TrendStats}}{{if $spark}}<div class="spark-wrap" title="Usage trend">{{$spark}}</div>{{end}}</div>{{end}}</div>{{else}}{{template "usage-fallback" .}}{{end}}<div class="card-footer">{{if .RefreshedText}}<span>{{.RefreshedText}}</span>{{end}}<span class="card-inspect">Inspect →</span></div></button>{{end}}

{{define "dial-card"}}{{$sparse := and (not .Graphs) (le (len .Tables) 1) (not .TrendStats) (not .DailyCost)}}<button type="button" class="agent agent-card{{if $sparse}} is-compact card-compact{{end}}{{if .IsAlert}} alert{{end}}{{if .Active}} selected{{end}}" hx-get="inspect?account={{urlquery .Key}}" hx-target="#inspect-content" hx-swap="innerHTML" style="--p:{{accent .AccentColor}};--tone:{{gaugeColor .FirstTone}}" aria-label="Inspect {{.AccountID}}">{{template "agent-head" .}}{{if or .Graphs .Tables .TrendStats}}<div>{{if .Graphs}}<div class="dial-row">{{range .Graphs}}{{if .Title}}<div class="gauge-group"><div class="gauge-group-title">{{.Title}}</div><div class="gauge-group-body">{{range .Items}}{{template "arc-gauge" .}}{{end}}</div></div>{{else}}{{range .Items}}{{template "arc-gauge" .}}{{end}}{{end}}{{end}}</div>{{end}}{{template "metric-table" .Tables}}{{$spark := dialSpark .DailyCost}}{{if or .TrendStats $spark}}<div class="agent-foot">{{template "metric-table" .TrendStats}}{{if $spark}}<div class="spark-wrap">{{$spark}}</div>{{end}}</div>{{end}}</div>{{else}}{{template "usage-fallback" .}}{{end}}<div class="card-footer">{{if .RefreshedText}}<span>{{.RefreshedText}}</span>{{end}}<span class="card-inspect">Inspect →</span></div></button>{{end}}

{{define "strip-card"}}<button type="button" class="agent agent-card{{if .IsAlert}} alert{{end}}{{if .Active}} selected{{end}}" hx-get="inspect?account={{urlquery .Key}}" hx-target="#inspect-content" hx-swap="innerHTML" style="--p:{{accent .AccentColor}};--tone:{{gaugeColor .FirstTone}}" aria-label="Inspect {{.AccountID}}"><div class="strip-id"><div class="card-identity"><div class="card-avatar" style="background:{{.AvatarBg}};color:{{.AvatarColor}}">{{.AvatarText}}</div> <div><span class="agent-name">{{if .StatusIcon}}{{.StatusIcon}}{{else}}●{{end}} {{.AccountID}}</span> <span class="agent-plan">{{subtitle .}}</span></div></div> <span class="pill {{pillClass .StatusBadge}}">{{if .StatusBadge}}{{.StatusBadge}}{{else}}{{.Status}}{{end}}</span></div><div class="strip-gauges">{{if .Graphs}}{{range .Graphs}}{{if .Title}}<div class="gauge-group"><div class="gauge-group-title">{{.Title}}</div><div class="gauge-group-body">{{range .Items}}{{template "strip-gauge" .}}{{end}}</div></div>{{else}}{{range .Items}}{{template "strip-gauge" .}}{{end}}{{end}}{{end}}{{end}}{{template "metric-table" .Tables}}{{template "metric-table" .TrendStats}}</div><div class="strip-trend">{{stripSpark .DailyCost}}</div></button>{{end}}

{{define "usage-fallback"}}<table class="metric-table"><tbody><tr><th scope="row">Usage</th><td>{{if .Message}}{{.Message}}{{else}}No data{{end}}</td></tr></tbody></table>{{end}}

{{define "lin-gauge"}}<div class="quota-row lin-gauge {{toneClass .Tone}}{{if .Depleted}} depleted{{end}}"><div class="q-header lin-name"><span class="q-title"><span class="q-pill">{{timebandPill .}}</span> {{cleanQuotaTitle (timebandPill .) .}}{{if .Depleted}} <span class="limit-flag">Limit reached</span>{{end}}</span><span class="q-vals">{{if .Value}}{{.Value}}{{else if .Pct}}{{pct0 .Pct}}%{{end}}</span></div><div class="lin-track"><div class="q-bar {{barTone .Tone}}" style="width:{{pct1 .Pct}}%;background:{{gaugeColor .Tone}}"></div></div><div class="q-foot lin-meta"><span>{{gaugeLeft .}}</span><span class="{{if .Urgent}}urgent{{end}}">{{gaugeRight .}}</span></div></div>{{end}}

{{define "arc-gauge"}}<div class="dial {{toneClass .Tone}}{{if .Depleted}} depleted{{end}}"><svg viewBox="0 0 88 58" class="dial-svg" aria-hidden="true"><path class="dial-track" d="M10 48 A34 34 0 0 1 78 48" pathLength="100"/><path class="dial-fill" d="M10 48 A34 34 0 0 1 78 48" pathLength="100" stroke="{{gaugeColor .Tone}}" stroke-dasharray="{{pct0 .Pct}} 100"/><text x="44" y="44" text-anchor="middle">{{arcHub .}}</text></svg><span class="dial-lab">{{if .Short}}{{.Short}}{{else}}{{.Label}}{{end}}{{if .Depleted}} <span class="limit-flag">Limit reached</span>{{end}}</span><span class="dial-reset{{if .Urgent}} urgent{{end}}">{{arcReset .}}</span></div>{{end}}

{{define "strip-gauge"}}<div class="strip-metric {{toneClass .Tone}}{{if .Depleted}} depleted{{end}}"><span class="strip-lab">{{if .Short}}{{.Short}}{{else}}{{.Label}}{{end}}</span><span class="strip-track"><i style="width:{{pct0 .Pct}}%;background:{{gaugeColor .Tone}}"></i><em>{{stripOverlay .}}</em></span><span class="strip-reset{{if .Urgent}} urgent{{end}}">{{stripReset .}}</span></div>{{end}}

{{define "metric-table"}}{{if .}}<table class="metric-table"><tbody>{{range .}}<tr><th scope="row">{{.Label}}</th><td>{{if .Value}}{{.Value}}{{else}}—{{end}}</td></tr>{{end}}</tbody></table>{{end}}{{end}}

{{define "icon-search"}}<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="4.2"/><path d="M10.3 10.3 14 14"/></svg>{{end}}
{{define "icon-contrast"}}<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.2"/><path d="M8 1.8a6.2 6.2 0 0 0 0 12.4z" fill="currentColor" stroke="none"/></svg>{{end}}
{{define "icon-refresh"}}<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.2 8a5.2 5.2 0 1 1-1.7-3.9"/><path d="M13.2 2.4V5.6h-3.2"/></svg>{{end}}
{{define "icon-grid"}}<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2" y="2" width="5.2" height="5.2" rx="1.4"/><rect x="8.8" y="2" width="5.2" height="5.2" rx="1.4"/><rect x="2" y="8.8" width="5.2" height="5.2" rx="1.4"/><rect x="8.8" y="8.8" width="5.2" height="5.2" rx="1.4"/></svg>{{end}}
{{define "icon-theme"}}<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3.1"/><path d="M8 1.4v1.7M8 12.9v1.7M1.4 8h1.7M12.9 8h1.7M3.4 3.4l1.2 1.2M11.4 11.4l1.2 1.2M12.6 3.4l-1.2 1.2M4.6 11.4l-1.2 1.2"/></svg>{{end}}
{{define "icon-keyboard"}}<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><rect x="1.6" y="4" width="12.8" height="8" rx="1.6"/><path d="M4 6.6h1.2M7.4 6.6h1.2M10.8 6.6H12M4 9.4h1.2M7.4 9.4h1.2M10.8 9.4H12M6.6 11.4h2.8"/></svg>{{end}}

{{define "footer"}}<div class="footer-left"><span class="live-dot" aria-hidden="true"></span><span class="fleet-note">{{if .FleetNote}}{{.FleetNote}}{{else}}no accounts loaded{{end}} · auto-refresh {{.RefreshSeconds}}s</span><span id="fetching-footer" class="fetching"><span class="spin" aria-hidden="true">⠋</span> <span class="fetching-text">Fetching...</span></span></div><nav class="footer-actions" aria-label="Quick actions"><button type="button" class="footer-btn" id="footer-btn-mode" hx-post="actions/usage-mode" aria-label="Toggle usage mode"><span class="btn-icon">{{template "icon-contrast"}}</span><span class="btn-label">{{.UsageModeLabel}}</span></button><button type="button" class="footer-btn" id="footer-btn-refresh" hx-get="partial/app?refresh=1&amp;layout={{.Layout.ID}}{{with .Selected}}&amp;focus={{urlquery .AccountID}}{{end}}" aria-label="Refresh focused account"><span class="btn-icon">{{template "icon-refresh"}}</span><span class="btn-label">refresh</span></button><button type="button" class="footer-btn" id="footer-btn-refresh-all" hx-get="partial/app?refresh=1&amp;layout={{.Layout.ID}}" aria-label="Refresh all accounts"><span class="btn-icon">{{template "icon-refresh"}}</span><span class="btn-label">refresh all</span></button><button type="button" class="footer-btn" id="footer-btn-providers" hx-get="partial/providers" hx-target="#providers-content" hx-swap="innerHTML" aria-label="Manage providers and boxes"><span class="btn-icon">{{template "icon-grid"}}</span><span class="btn-label">providers</span></button><button type="button" class="footer-btn" id="footer-btn-keys" aria-label="Keyboard shortcuts"><span class="btn-icon">{{template "icon-keyboard"}}</span><span class="btn-label">keys</span></button><span class="footer-theme"><span class="btn-icon" aria-hidden="true">{{template "icon-theme"}}</span><select id="footer-theme-select" class="footer-theme-select" name="theme" aria-label="Theme" hx-post="actions/theme" hx-include="this" hx-trigger="change">{{$active := .Env.ThemeTokens.Name}}{{range .Env.AvailableThemes}}<option value="{{.}}"{{if eq . $active}} selected{{end}}>{{.}}</option>{{end}}</select></span></nav>{{end}}

{{define "inspect"}}<h2 id="inspect-title" class="inspect-title" hx-swap-oob="outerHTML">{{if .V.StatusIcon}}{{.V.StatusIcon}}{{else}}●{{end}} {{.V.AccountID}}{{if .V.StatusBadge}} · {{.V.StatusBadge}}{{end}}</h2>{{template "cockpit-modal" .}}{{end}}

{{define "apple-logo"}}<svg class="au-apple-logo" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="auSquircleGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#2c2c2e"/>
      <stop offset="100%" stop-color="#141416"/>
    </linearGradient>
    <linearGradient id="auGaugeGrad" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#2997ff"/>
      <stop offset="60%" stop-color="#0071e3"/>
      <stop offset="100%" stop-color="#5ac8fa"/>
    </linearGradient>
    <linearGradient id="auBorderGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="rgba(255,255,255,0.24)"/>
      <stop offset="50%" stop-color="rgba(255,255,255,0.06)"/>
      <stop offset="100%" stop-color="rgba(0,0,0,0.35)"/>
    </linearGradient>
  </defs>
  <rect x="1" y="1" width="30" height="30" rx="7.2" fill="url(#auSquircleGrad)" stroke="url(#auBorderGrad)" stroke-width="1"/>
  <path d="M 9.5 21.5 A 9 9 0 1 1 22.5 21.5" stroke="url(#auGaugeGrad)" stroke-width="2.2" stroke-linecap="round" fill="none"/>
  <path d="M 8.5 16.5 L 12 16.5 L 14 12.5 L 17 20.5 L 19 16.5 L 23.5 16.5" stroke="#ffffff" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <circle cx="16" cy="7" r="1.25" fill="#30d158"/>
</svg>{{end}}

{{define "apple-logo-lg"}}<svg class="au-apple-logo-lg" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="auSquircleGradLg" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#2c2c2e"/>
      <stop offset="100%" stop-color="#141416"/>
    </linearGradient>
    <linearGradient id="auGaugeGradLg" x1="8" y1="8" x2="56" y2="56" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#2997ff"/>
      <stop offset="60%" stop-color="#0071e3"/>
      <stop offset="100%" stop-color="#5ac8fa"/>
    </linearGradient>
    <linearGradient id="auBorderGradLg" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="rgba(255,255,255,0.28)"/>
      <stop offset="50%" stop-color="rgba(255,255,255,0.08)"/>
      <stop offset="100%" stop-color="rgba(0,0,0,0.45)"/>
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="60" height="60" rx="14.5" fill="url(#auSquircleGradLg)" stroke="url(#auBorderGradLg)" stroke-width="1.6"/>
  <path d="M 19 43 A 18 18 0 1 1 45 43" stroke="url(#auGaugeGradLg)" stroke-width="4.2" stroke-linecap="round" fill="none"/>
  <path d="M 17 33 L 24 33 L 28 25 L 34 41 L 38 33 L 47 33" stroke="#ffffff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <circle cx="32" cy="14" r="2.5" fill="#30d158"/>
</svg>{{end}}
